# The client build needs Vite/Tailwind/PostCSS, which live in devDependencies.
# Some hosts (Railway/Nixpacks among them) set NPM_CONFIG_PRODUCTION, which would
# strip those and make `npm run build` fail with "vite: not found".
# Keep dev dependencies installable so the production bundle can be built.
production=false

# Reproducible, quieter CI installs.
fund=false
audit=false
