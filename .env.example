# ------------------------------------------------------------------
# KyyWA — environment configuration
# Copy to .env for local development. On Railway set these as Variables.
# ------------------------------------------------------------------

# HTTP server
PORT=8080
HOST=0.0.0.0

# Where Baileys auth state, the message store and cached media live.
# On Railway mount a Volume and point this at its mount path (e.g. /data).
DATA_DIR=./data

# Comma separated list of allowed origins, or * for any.
CORS_ORIGIN=*

# Optional. When set, the UI asks for this token before it can talk to the API
# and Socket.io connections must present it too. Strongly recommended in prod.
ACCESS_TOKEN=

# Device name shown under WhatsApp → Linked devices
BROWSER_NAME=KyyWA

# Upload ceiling for photos/videos/documents, in megabytes
MAX_UPLOAD_MB=64

# How many messages per chat are kept in memory / on disk
MESSAGE_CACHE_SIZE=250

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- client build-time only -------------------------------------------------
# Leave empty when the client is served by this same server (default).
# VITE_API_URL=
